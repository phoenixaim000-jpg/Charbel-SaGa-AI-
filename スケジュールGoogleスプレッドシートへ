"""
Charbel SaGa Matching & Steering Engine
機能:
 1. ユーザーごとのヒアリングに基づく【可変星マーク(★)算出】
 2. 外部Googleスプレッドシートへのデータ同期・送出
 3. かち合う仲間・パートナーとの【運命調整アシスト (Fine-play Engine)】
"""

import pandas as pd
import json

class CharbelSaGaEngine:
    def __init__(self, user_profile):
        self.user_profile = user_profile
        # ヒアリング結果に基づいて星マークの付与基準をセット
        self.priority_weights = self.setup_hearing_weights(user_profile.get("hearing_answers"))

    def setup_hearing_weights(self, answers):
        """ヒアリング結果から優先度ロジックを可変構築"""
        first_choice = answers.get("first_priority")
        
        if first_choice == "world_mission": # あなたの優先順位
            return {"mission": 5, "money": 4, "passion": 3}
        elif first_choice == "money_first":  # 収益優先顧客
            return {"money": 5, "passion": 4, "mission": 3}
        else:                               # クリエイター優先顧客
            return {"passion": 5, "mission": 4, "money": 3}

    def calculate_star_rating(self, task_type):
        """星マーク(★)を動的に付与"""
        weight = self.priority_weights.get(task_type, 3)
        stars = "★" * weight + "☆" * (5 - weight)
        return stars

    def fine_play_match_assist(self, my_tasks, partner_pool):
        """
        【出来レース・ファインプレイ操作エンジン】
        互いの需要（シナリオ力 × 資金力 / ブランド力）が重なる仲間を特定し、
        時間や世界線の重複を回避して最高のタイミングで引き合わせる。
        """
        matched_results = []
        
        for task in my_tasks:
            stars = self.calculate_star_rating(task["type"])
            
            # パートナープールから相性抜群の相手を強制検索・補正
            for partner in partner_pool:
                if task["need_skill"] in partner["provide_skill"]:
                    match_data = {
                        "task_title": task["title"],
                        "star_rating": stars,
                        "partner_name": partner["name"],
                        "assist_status": "🔥 運命調整補正発動（絶対成功ルート）",
                        "fineplay_action": f"【{partner['name']}】とのスケジュール重複を回避し、最高のタイアップを実現",
                        "target_sheet_url": f"https://docs.google.com/spreadsheets/d/{partner['sheet_id']}"
                    }
                    matched_results.append(match_data)
                    
        return pd.DataFrame(matched_results)

